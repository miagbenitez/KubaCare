# Copiá este archivo como .env y completá con los datos de tu app de Meta.

# Token de acceso temporal que aparece en WhatsApp → API Setup (vence en ~24 hs)
META_ACCESS_TOKEN=EAAG...

# Phone number ID (NO es el número de teléfono, es un ID numérico)
META_PHONE_NUMBER_ID=123456789012345

# Token elegido por vos para verificar el webhook (por ejemplo: kubacare2026)
META_VERIFY_TOKEN=kubacare2026

# Versión de la Graph API (usá la que muestra Meta en API Setup)
META_API_VERSION=v21.0

# Puerto local del servidor webhook
PORT=3000

# Opcional: números autorizados separados por comas, sin + ni espacios.
# Vacío = el bot responde a cualquiera que le escriba (Cloud API solo permite 1:1).
ALLOWED_NUMBERS=

# true = no envía mensajes reales, solo los imprime en la terminal.
DRY_RUN=false
